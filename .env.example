APP_NAME="URL Shortener API"
APP_VERSION="2.0.0"
DEBUG=false
BASE_URL="http://localhost:8000"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=url_shortener
DATABASE_URL=sqlite:///./url_shortener.db

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# Admin key for listing all links and managing any link (empty = disabled). Use a long random value.
ADMIN_API_KEY=
# Private salt for visitor IP hashing in analytics.
IP_HASH_SALT=change-me
# Reverse proxies in front of the app (Railway: 1; direct access: 0).
TRUSTED_PROXY_HOPS=1
